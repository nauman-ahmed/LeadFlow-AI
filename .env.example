# LeadFlow AI — environment variables template
# Copy to `.env` and fill in real values. Never commit `.env`.

# -----------------------------------------------------------------------------
# Supabase (Postgres + pgvector + Auth)
# Project Settings -> API -> URL / anon / service_role
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# LLM providers
# LLM_PROVIDER controls which provider runs in chat/RAG/summaries: ollama | openai
# Embeddings always go through the same provider unless EMBEDDING_PROVIDER is set.
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# OpenAI (only used if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=mistral:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# n8n (orchestration hub)
# N8N_WEBHOOK_BASE_URL is what the widget/backend POST to.
# N8N_API_KEY is optional — only needed for CLI workflow import.
# -----------------------------------------------------------------------------
N8N_URL=http://localhost:5678
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_API_KEY=
N8N_WEBHOOK_SECRET=replace-with-random-string

# -----------------------------------------------------------------------------
# Cal.com (Sprint 3)
# -----------------------------------------------------------------------------
CAL_API_KEY=
CAL_WEBHOOK_SECRET=
CAL_EVENT_TYPE_ID=

# -----------------------------------------------------------------------------
# Vapi (Sprint 4) — voice agent
# -----------------------------------------------------------------------------
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email notifications (Sprint 6) — operator handoff alerts
# Pick one: SMTP (any provider) OR Resend (recommended free tier)
# -----------------------------------------------------------------------------
EMAIL_FROM=
EMAIL_OPERATOR_TO=

# SMTP option (Gmail app password, Mailtrap, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend option (https://resend.com - 3000 free emails/month)
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# HubSpot (Sprint 6) — real CRM integration (toggleable)
# -----------------------------------------------------------------------------
HUBSPOT_ENABLED=false
HUBSPOT_PRIVATE_APP_TOKEN=

# -----------------------------------------------------------------------------
# App / runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

LEADFLOW_TENANT_NAME=Acme CRM Onboarding
LEADFLOW_DEFAULT_LANGUAGE=en
LEADFLOW_SECONDARY_LANGUAGE=fr
LEADFLOW_QUALIFICATION_THRESHOLD=60
LEADFLOW_RAG_SIMILARITY_THRESHOLD=0.72

# Comma-separated origins allowed to load the widget
LEADFLOW_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
